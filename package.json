    "serverless-http": "^3.2.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vaul": "^1.1.2",
    "vite": "7.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  }
}
