{
  "name": "fusion-starter",
  "private": true,
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n vite,nest -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "node scripts/wait-for-api.mjs && vite",
    "dev:server": "nest start --watch",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "nest build",
    "start": "node dist/server/main.js",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.netlify.json --noEmit",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "mail:test": "node --env-file=.env scripts/test-mail.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.29",
    "@types/multer": "2.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "9.7.3",
    "multer": "2.2.0",
    "pdfjs-dist": "^5.4.449",
    "react-pdf": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
